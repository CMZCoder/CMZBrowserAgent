{
  "name": "@browser-agent/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "browser-agent": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts start",
    "start:dist": "node dist/cli.js start",
    "cli": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^4.0.8"
  }
}
